# Copy this file to ".env" and fill in the values. NEVER commit the real .env.

# Bot token: https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Your test server's ID. Turn on Developer Mode (User Settings → Advanced → Developer Mode),
# then right-click the server icon → "Copy Server ID".
# Setting this makes slash commands appear INSTANTLY on that one server while developing.
# Leave it blank in production to register commands globally (can take up to ~1 hour to show up).
GUILD_ID=

# Where the SQLite database file lives. The default is fine for local dev.
DB_PATH=electrium_bot.db
